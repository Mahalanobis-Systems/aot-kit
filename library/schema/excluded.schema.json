{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Excluded and archived optimizations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "excluded",
    "archived"
  ],
  "properties": {
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "see": {
            "type": "string"
          },
          "pattern": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "group",
              "source",
              "family",
              "sub_type",
              "categories"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^P[0-9]{2}$"
              },
              "name": {
                "type": "string"
              },
              "group": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "master",
                  "catalog",
                  "both"
                ]
              },
              "family": {
                "enum": [
                  "prompt",
                  "tool",
                  "workflow",
                  "config",
                  "dependency",
                  "other"
                ]
              },
              "sub_type": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "categories": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z-]*\\.[a-z][a-z-]*$"
                }
              },
              "assessment": {
                "type": "object",
                "description": "The pattern's whole first-pass assessment (detection, qa, impact), kept as it was."
              }
            },
            "description": "A library pattern that is the same change as this entry and has no entry of its own, kept whole."
          }
        }
      }
    },
    "archived": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "archived_on",
          "reason",
          "entry"
        ],
        "properties": {
          "archived_on": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "entry": {
            "type": "object",
            "description": "The entry as it was when archived, in the old technique format."
          }
        }
      }
    }
  }
}
